# R2 synthetic-only RustDesk client. Build context must include the official,
# separately SHA-256 verified 1.5.1 Debian package. Never install package
# postinst, system services, or run a real user/client configuration.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      ca-certificates dbus-x11 xvfb xauth x11-xserver-utils procps \
      libgtk-3-0t64 libayatana-appindicator3-1 libxdo3 \
      libxcb1 libx11-6 libx11-xcb1 libxrandr2 libxdamage1 \
      libxfixes3 libxext6 libxrender1 libxss1 libasound2t64 \
      libpulse0 libegl1 libgl1 libgbm1 libdrm2 libnss3 \
      libxkbcommon0 libxkbcommon-x11-0 libglib2.0-0t64 \
      libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
      libpipewire-0.3-0 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

COPY rustdesk-1.5.1-x86_64.deb /tmp/rustdesk-1.5.1-x86_64.deb
RUN dpkg-deb -x /tmp/rustdesk-1.5.1-x86_64.deb / \
    && candidate="$(find /usr -type f -name rustdesk -perm /111 | head -n 1)" \
    && test -n "$candidate" \
    && ln -s "$candidate" /usr/local/bin/rustdesk \
    && rm /tmp/rustdesk-1.5.1-x86_64.deb

RUN useradd --uid 10001 --create-home --shell /bin/sh peer \
    && install -d -o peer -g peer -m 0700 /home/peer/.config/rustdesk
USER peer
WORKDIR /home/peer
ENV HOME=/home/peer XDG_CONFIG_HOME=/home/peer/.config DISPLAY=:99
CMD ["sleep", "infinity"]
