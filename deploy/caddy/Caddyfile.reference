# REFERENCE ONLY — DO NOT DEPLOY.
# D-07 V0.1 single-host, isolated synthetic acceptance template.
# No real Agent routes are implemented in Spring; default deny returns 403.
# This is end-to-end mTLS: Agent -> Caddy (client-identity CA), and separately
# Caddy -> Spring (dedicated upstream client certificate / backend server CA).
# These independent trust domains MUST NOT share private keys or CAs.
# Before even a synthetic deployment, run caddy adapt / validate AND
# prove hostname, HTTP/2 coalescing, mTLS, direct backend and revocation negatives.
# Caddy must own TCP/443; Spring must bind TLS+mTLS 127.0.0.1:8443.
# NEVER publish 8443 through Docker, VPN, or reverse NAT. A local process
# without Caddy's separately approved upstream-client key must fail TLS.
# Spring's application-agent-upstream-mtls-acceptance.yml opt-in profile
# requires a dedicated backend TLS server identity and Caddy-client CA.
# Mount a real approved DEDICATED PUBLIC CLIENT CA PEM at the path below;
# do NOT use the Caddy internal *server* CA as the client-identity CA.
{
    admin off
    auto_https disable_redirects
    servers :443 {
        protocols h1 h2
        strict_sni_host on
    }
}

# Browser console and pairing are deliberately NOT proxied in this example;
# they retain independent hostnames without accidental Agent route access.
console.lanveriq.internal {
    tls internal
    respond "Console not enabled in this reference configuration" 503
}

enroll.lanveriq.internal {
    tls internal
    respond "Pairing not enabled in this reference configuration" 503
}

agent.lanveriq.internal {
    tls internal {
        client_auth {
            mode require_and_verify
            trust_pool file /etc/lanveriq/pki/approved-client-ca.pem
        }
    }

    # This list is a candidate for later approved handlers ONLY.
    # Default-deny Spring Security blocks all these paths today.
    @agentRoutes path /api/v1/devices/*/activate /api/v1/devices/*/heartbeats /api/v1/devices/*/event-batches /api/v1/devices/*/inventory
    handle @agentRoutes {
        # Caddy 2.11 applies reverse_proxy header_up Set BEFORE Delete,
        # regardless of the order written in this block. If we strip
        # X-Lanveriq-Verified-Client-* within header_up, it deletes the
        # freshly injected verified fingerprint as well. Strip all
        # untrusted identity claims BEFORE the proxy sets its trusted value.
        request_header -X-Lanveriq-Verified-Client-*
        reverse_proxy https://127.0.0.1:8443 {
            transport http {
                tls
                tls_client_auth /etc/lanveriq/pki/caddy-upstream-client.crt /etc/lanveriq/pki/caddy-upstream-client.key
                tls_trust_pool file /etc/lanveriq/pki/backend-server-ca.pem
                tls_server_name spring-backend.lanveriq.internal
                versions 1.1 2
            }
            # Request identity family is already stripped by the preceding
            # request_header handler, so this set cannot be wildcard-deleted.
            # Other legacy claimed client-certificate headers are removed
            # here, and never trusted as an authentication assertion.
            header_up -X-Forwarded-Client-Cert
            header_up -SSL-Client-Cert
            header_up X-Lanveriq-Verified-Client-Fingerprint {http.request.tls.client.fingerprint}
            header_up Host agent.lanveriq.internal
        }
    }

    # Unrecognized Agent routes fail at the edge.
    handle {
        respond "Unavailable" 404
    }
}
