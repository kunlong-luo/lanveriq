{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "react"
    ],
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "generated/**/*.ts"
  ]
}
