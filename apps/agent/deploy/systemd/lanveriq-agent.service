# Pop!_OS 24.04 LTS / Ubuntu-family systemd system-service TEMPLATE.
# Not installed or enabled by checkout/CI. An approved installer and consent
# gate are required before any real endpoint deployment.
# Batch A: IDLE agent only. Network, enrollment, collection and remote access
# are deliberately unavailable in the systemd sandbox.
[Unit]
Description=Lanveriq Agent (idle, offline, synthetic-safe)
Documentation=https://github.com/kunlong-luo/lanveriq
ConditionPathExists=/etc/lanveriq-agent/agent.toml

[Service]
Type=exec
# Non-root and not tied to the logged-in COSMIC desktop session.
DynamicUser=yes
StateDirectory=lanveriq-agent
StateDirectoryMode=0700
RuntimeDirectory=lanveriq-agent
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/bin/lanveriq-agent --config /etc/lanveriq-agent/agent.toml
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
SocketBindDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes

# Permission to deploy and enable is separately gated. This [Install] section
# is deliberately passive: CI MUST NOT call systemctl enable/start on a host.
[Install]
WantedBy=multi-user.target
