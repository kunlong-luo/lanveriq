{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lanveriq-desktop",
  "version": "0.1.0",
  "identifier": "com.lanveriq.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:3210",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lanveriq Desktop · Offline Preview",
        "width": 1150,
        "height": 760,
        "minWidth": 780,
        "minHeight": 550,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.39)",
          "libcairo2 (>= 1.10.0)",
          "libdbus-1-3 (>= 1.9.14)",
          "libgcc-s1 (>= 4.2)",
          "libgdk-pixbuf-2.0-0 (>= 2.36.9)",
          "libglib2.0-0t64 (>= 2.66.0)",
          "libgtk-3-0t64 (>= 3.21.5)",
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0 (>= 3.0.3)",
          "libwebkit2gtk-4.1-0 (>= 2.41.90)"
        ]
      }
    }
  }
}
