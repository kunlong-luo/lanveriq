{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lanveriq-desktop",
  "version": "0.1.0",
  "identifier": "com.lanveriq.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:3210",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lanveriq Desktop · Offline Preview",
        "width": 1150,
        "height": 760,
        "minWidth": 780,
        "minHeight": 550,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.png"]
  }
}
